# Token del bot, fornito da @BotFather su Telegram.
# Copia questo file in ".env" e incolla qui il tuo token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Facoltativo ma consigliato: chiave OpenRouteService per il calcolo dei km
# a partire dalle localita'. E' gratuita e non richiede carta di credito:
# registrati su https://account.heigit.org e crea un token.
# Senza chiave il bot usa i server pubblici di OpenStreetMap (Nominatim +
# OSRM), che funzionano ma sono demo server senza garanzie di servizio.
# ORS_API_KEY=

# Facoltativo: percorso del file JSON con i coefficienti personalizzati.
# Se non impostato, viene usato ./dati/coefficienti.json
# COEFFICIENTI_PATH=./dati/coefficienti.json
